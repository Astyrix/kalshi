# Copy to .env (never commit it). The code reads these from the environment.
# Databento historical API key (32 characters, starts with db-).
DATABENTO_API_KEY=db-your-key-here
# Hard ceiling on Databento spend for one command, in USD. 0 = never download paid data.
# A download also needs --approve-usd on the command line at or above the quoted cost.
TRADESYS_MAX_SPEND_USD=0
